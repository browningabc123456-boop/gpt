  "fixes": [
    {
      "problem": "连续摆放的电流点击声",
      "change": "网页与小工具共用PCM拟音，旧声音淡出后停止；大米袋装降低尖锐频段，瓶子音量保持原值。75次连续音效混音检查：无削波、无瞬间停止。"
    },
    {
      "problem": "初始画面过暗",
      "change": "调亮白天环境补光、墙面、地板和仓库外背景，保留暖色和原有场景切换。"
    },
    {
      "problem": "双指旋转方向相反",
      "change": "改为手指顺时针时场景同向旋转，逆时针同理；同时检查双指平移、张开放大。"
    },
    {
      "problem": "物品杂线、边缘不清",
      "change": "修复纹理接缝引发的白色杂线，降低法线噪声，改善透明边缘和远景采样；物品显示范围限制在实际占位内，俯视冷柜仍可看见。"
    },
    {
      "problem": "冰箱穿模与破洞",
      "change": "修复简化网格的缺失背板、侧板、底板和顶板，移除破损原壳体及旧抽屉与首层的冲突；门和外壳不再低于地面或超出高度。"
    },
    {
      "problem": "额外发现的缩略图问题",
      "change": "修复低档预览的旧裁切坐标以及高清图集比例变化造成的串图和空白。"
    }
  ],
