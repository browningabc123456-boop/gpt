  "fixes": [
    {
      "problem": "样板的渲染负担较重",
      "change": "详细模型与远景模型分开；重复物品实例化，合并实体材质；玻璃保留透明与反射，取消整场景折射；移除全屏多遍后期处理，只保留局部阴影。"
    },
    {
      "problem": "切换分类时现场生成缩略图",
      "change": "135个新模型提前渲染为一张缩略图表，手机切换分类、搜索和滚动不再调用GPU截图。"
    },
    {
      "problem": "模型数据偏大",
      "change": "压缩顶点和索引数据，按需解压当前使用的模型。图册数据由约19.3MB降为8.6MB，运行脚本约9MB；传输大小取决于网站压缩。"
    },
    {
      "problem": "延迟输入可能把短点按当成长按",
      "change": "等待点按判定时延后重绘；按事件原始时间戳区分短点按，避免缓冲中的短按留下整列物品。"
    },
    {
      "problem": "缺少一键清空",
      "change": "顶部垃圾桶可清空所有货架物资、容器内堆叠和待恢复物资。确认数量包含每一层，保留家具、位置、方向和设置，可整组撤销。"
    },
    {
      "problem": "容器结构和取景不够清楚",
      "change": "重新制作冰箱内胆、门封、门篮、抽屉、铰链；冷柜有内胆、开盖、胶条、温控和散热孔；木柜、衣柜、玻璃柜、收纳箱等分别制作。深箱改用较高视角，取景包括掀起的盖子。"
    },
    {
      "problem": "前排家具遮住正在查看的储物柜",
      "change": "近看时将挡住目标的前排家具暂时隐藏，移动家具模式恢复全部家具，物资和布局数据保持不变。"
    },
    {
      "problem": "锅盖和部分薄面被单面裁剪",
      "change": "按原Blender材质保留双面表面，修复从上方看不见锅盖等薄面的问题。"
    },
    {
      "problem": "低配置兼容和静止画面",
      "change": "场景按变化重绘、降低手机像素倍率，并保留省电画质。实体材质的数据打包后，实例化绘制只需8个顶点属性位置，另测WebGL1启动。"
    }
  ],
